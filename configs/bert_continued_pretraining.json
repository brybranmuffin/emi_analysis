{
  "model_family": "bert",
  "model_name": "bert-base-uncased",
  "max_length": 256,
  "objective": "mlm",
  "epochs": 2.5,
  "checkpoint_interval": 0.1,
  "train_data_path": "data/train.jsonl",
  "heldout_data_path": "data/heldout/congressional.jsonl",
  "general_data_path": "data/heldout/general.jsonl",
  "evidence_lexicon_path": "data/lexicons/evidence_lexicon.csv",
  "intuition_lexicon_path": "data/lexicons/intuition_lexicon.csv",
  "output_dir": "checkpoints/bert",
  "batch_size": 32,
  "gradient_accumulation_steps": 1,
  "learning_rate": 5e-05,
  "weight_decay": 0.01,
  "seed": 42,
  "min_chunk_tokens": 32,
  "lr_scheduler": "linear",
  "warmup_ratio": 0.0,
  "max_grad_norm": 1.0,
  "bf16": true,
  "eval_max_chunks": 10000,
  "log_every": 100,
  "general_loss_max_rel_increase": 0.2,
  "seed_drift_threshold": 0.1,
  "stop_on_flag": true
}
